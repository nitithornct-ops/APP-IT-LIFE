SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGINS=http://localhost:5173
ENVIRONMENT=development
PUBLIC_APP_URL=http://localhost:5173

# LINE ticket portal for linked employees — optional. Leave LINE_LOGIN_ENABLED unset/false to keep it
# off. Get these from LINE Developers Console + LINE Official Account Manager; see
# docs/migration/phase7-migration-runbook.md.
LINE_LOGIN_ENABLED=false
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=http://localhost:8787/api/v1/line/callback
LINE_SESSION_SECRET=
LINE_SESSION_HOURS=24
NOTIFY_LINE_ENABLED=false
LINE_CHANNEL_ACCESS_TOKEN=
# เมื่อเปิดใช้งาน การแจ้งเตือน in-app จะส่งคู่ไปยังบัญชี LINE สถานะ Active ที่เชื่อมกับผู้ใช้
LINE_DEFAULT_TO=

# ส่งออกไป Google Drive / Google Sheets (services/googleDriveService.ts) — ปิดเป็นค่าเริ่มต้น
# ต้องครบทั้งสามค่าและ GOOGLE_DRIVE_ENABLED=true จึงจะเปิดใช้งาน
# 1) สร้าง Service Account ใน Google Cloud แล้วเปิด Google Drive API ในโปรเจกต์นั้น
# 2) สร้าง Shared Drive (หรือโฟลเดอร์ในนั้น) แล้วเชิญอีเมลของ Service Account เป็น Content manager
#    — Service Account ไม่มีพื้นที่เก็บของตัวเอง อัปโหลดลง My Drive จะได้ storageQuotaExceeded
# 3) GOOGLE_DRIVE_FOLDER_ID คือรหัสในลิงก์ของโฟลเดอร์ปลายทาง
# ห้าม commit ค่าจริง — บน production ตั้งผ่าน `wrangler secret put` เท่านั้น
GOOGLE_DRIVE_ENABLED=false
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
