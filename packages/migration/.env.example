# Copy to .env and fill in before running `npm run rehearse --workspace=packages/migration`.
# Never commit the real .env — it holds a service-role key and a direct DB connection string.

# Path to a JSON file shaped like LegacyWorkbook: { "SheetName": [ {row}, ... ], ... }.
# No raw legacy data lives in this repo — supply your own export here.
LEGACY_WORKBOOK_PATH=

# Optional. JSON array of allowlisted Settings keys, e.g. ["MAINTENANCE_MODE"].
# Without this, every Settings row is archived rather than activated (see importPlan.ts).
SETTINGS_ALLOWLIST_PATH=

# Supabase project URL and service-role key (same values as apps/api/.dev.vars) — used for
# the Auth Admin invite API, not for SQL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (Supabase dashboard: Settings -> Database -> Connection
# string -> "URI", not the pooler string — the executor needs one persistent connection per
# run so that BEGIN/COMMIT/ROLLBACK stay on the same session).
SUPABASE_DB_URL=
